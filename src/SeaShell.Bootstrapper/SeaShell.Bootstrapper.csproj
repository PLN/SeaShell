<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<AssemblyName>seashell</AssemblyName>
		<PackageId>SeaShell</PackageId>
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>seashell</ToolCommandName>
		<Description>SeaShell bootstrapper — installs/updates the SeaShell C# scripting engine.</Description>
		<PackageTags>scripting;seashell;csharp;vb;roslyn;repl;cli;installer</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<IsPackable>true</IsPackable>
	</PropertyGroup>
	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="/" />
	</ItemGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="EngineTest" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\SeaShell.Common\SeaShell.Common.csproj" />
		<ProjectReference Include="..\SeaShell.Protocol\SeaShell.Protocol.csproj" />
		<ProjectReference Include="..\SeaShell.Installer\SeaShell.Installer.csproj" />
	</ItemGroup>
	<!--
	The per-RID archives are embedded only when asked for explicitly:
	CI's package job stages archives/{rid}.zip and runs
	'dotnet pack -p:EmbedArchives=true'. Every other build — dev builds, and
	the per-RID 'dotnet publish' that ships seashell[.exe] inside each archive —
	carries no archive, whatever happens to be in archives/. A bootstrapper
	without an archive treats 'install' as 'update' (fetch the latest package).
	-->
	<PropertyGroup>
		<EmbedArchives Condition="'$(EmbedArchives)' == ''">false</EmbedArchives>
	</PropertyGroup>
	<ItemGroup Condition="'$(EmbedArchives)' == 'true'">
		<EmbeddedResource Include="archives\*.zip" />
	</ItemGroup>
	<Target Name="SeaShellRequireArchives" BeforeTargets="BeforeBuild" Condition="'$(EmbedArchives)' == 'true'">
		<Error Condition="'@(EmbeddedResource->WithMetadataValue('Extension', '.zip'))' == ''"
			Text="EmbedArchives=true, but there is no archives\*.zip in $(MSBuildProjectDirectory) to embed." />
	</Target>
</Project>
